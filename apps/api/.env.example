# Local demo only. Copy to apps/api/.env. Do not put a live database password or a real auth secret here.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://hangwise:hangwise@127.0.0.1:5432/hangwise
AUTH_MODE=development
DEV_AUTH_SECRET=hangwise-dev-secret
CORS_ORIGINS=http://127.0.0.1:3000
DEMO_MODE=true
PAYMENTS_MODE=disabled
VERIFICATION_MODE=unavailable
HANGWISE_REPOSITORY=prisma
# Leave unset. There is no default platform fee.
# PLATFORM_FEE_BPS=
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
