{
  "name": "hangwise-api",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/seed.ts\"",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --testPathPatterns=postgres.integration --testPathIgnorePatterns=/node_modules/",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "openapi": "node dist/scripts/write-openapi.js",
    "worker": "node dist/worker.js"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-fastify": "12.4.0",
    "@nestjs/swagger": "12.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.9",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
