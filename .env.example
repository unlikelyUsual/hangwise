# Copy to apps/api/.env. These values are local demo placeholders, not production secrets.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://hangwise:hangwise@127.0.0.1:5432/hangwise
AUTH_MODE=development
DEV_AUTH_SECRET=hangwise-dev-secret
CORS_ORIGINS=http://127.0.0.1:3000
DEMO_MODE=true
PAYMENTS_MODE=disabled
VERIFICATION_MODE=unavailable
HANGWISE_REPOSITORY=prisma
# Leave PLATFORM_FEE_BPS unset. This skeleton has no assumed take rate.
# PLATFORM_FEE_BPS=
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
