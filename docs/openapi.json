  "info": {
    "title": "Hangwise API",
    "description": "Demo skeleton for a paid, non-sexual, one-day public date marketplace. Payments, identity verification, and production authentication are not implemented. Development auth is rejected unless NODE_ENV is development or test and AUTH_MODE=development. Companion ages are fictional and unverified. A hold does not charge a card.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Local API"
    }
  ],
  "components": {
    "securitySchemes": {
      "devUser": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Hangwise-Dev-User"
      },
      "devSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Hangwise-Dev-Secret"
      }
    },
    "schemas": {
      "CreateBookingDto": {
        "type": "object",
        "properties": {
          "companionProfileId": {
            "type": "string",
            "format": "uuid"
          },
          "startsAt": {
            "type": "string",
            "example": "2026-11-12T03:00:00.000Z"
          },
          "endsAt": {
            "type": "string",
            "example": "2026-11-12T05:00:00.000Z"
          },
          "venueName": {
            "type": "string",
            "example": "Lumpini Park"
          },
          "venueArea": {
            "type": "string",
            "example": "Pathum Wan"
          },
          "note": {
            "type": "string"
          },
          "acknowledgedPublicDatePolicy": {
            "type": "boolean",
            "description": "Must be true. Acknowledges the public, non-sexual date policy."
          }
        },
        "required": [
          "companionProfileId",
          "startsAt",
          "endsAt",
          "venueName",
          "venueArea",
          "acknowledgedPublicDatePolicy"
        ]
      },
      "HoldBookingDto": {
        "type": "object",
        "properties": {
          "holdMinutes": {
            "type": "number",
            "minimum": 15,
            "maximum": 120,
            "description": "Minutes until the hold expires. This does not authorize a payment."
          }
        },
        "required": [
          "holdMinutes"
        ]
      },
      "CreateMessageDto": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string"
          }
        },
        "required": [
          "body"
        ]
      },
      "CheckoutDto": {
        "type": "object",
        "properties": {}
      },
      "StartVerificationDto": {
        "type": "object",
        "properties": {}
      },
      "CreateReportDto": {
        "type": "object",
        "properties": {
          "subjectUserId": {
            "type": "string",
            "format": "uuid"
          },
          "bookingId": {
            "type": "string",
            "format": "uuid"
          },
          "category": {
            "type": "string",
            "enum": [
              "policy",
              "safety",
              "other"
            ]
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "category",
          "body"
        ]
      },
      "CreateBlockDto": {
        "type": "object",
        "properties": {
          "blockedUserId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "blockedUserId"
        ]
      },
      "CreateCheckInDto": {
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "string",
            "format": "uuid"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "bookingId",
          "note"
        ]
      },
      "CreateReviewDto": {
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "string",
            "format": "uuid"
          },
          "rating": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "bookingId",
          "rating",
          "body"
        ]
      }
    }
  }
}
